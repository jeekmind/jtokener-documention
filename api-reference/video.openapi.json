{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://tokener.jeekmind.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "info": {
    "title": "通用视频接口",
    "version": "0.1.0",
    "description": "Schema 导出预览，仅描述正常响应，错误响应暂未建模。"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "技元 API 密钥"
      }
    },
    "schemas": {
      "VideoTask": {
        "title": "OpenAIVideoResponse",
        "description": "标准视频任务对象。保存 id，用于查询任务和下载视频。",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "in_progress",
              "completed",
              "failed",
              "unknown"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "completed_at": {
            "type": "integer",
            "description": "完成时间，Unix 秒级时间戳；创建响应中未完成时省略"
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "gxc-doubao-seedance-2-5-260628",
            "status": "queued",
            "progress": 0,
            "created_at": 1793851200
          },
          {
            "id": "video_example",
            "object": "video",
            "model": "gxc-doubao-seedance-2-5-260628",
            "status": "completed",
            "progress": 100,
            "created_at": 1793851200,
            "completed_at": 1793851260
          }
        ]
      }
    }
  },
  "paths": {
    "/v1/videos/{id}": {
      "get": {
        "tags": [
          "通用视频接口"
        ],
        "operationId": "getVideo",
        "summary": "查询视频任务",
        "description": "使用创建响应中的 id 查询。status 为 completed 后可下载视频。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "提交任务返回的公开任务 ID",
            "schema": {
              "type": "string"
            },
            "example": "video_example"
          }
        ],
        "responses": {
          "200": {
            "description": "视频任务对象",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                }
              }
            }
          }
        }
      }
    },
    "/v1/videos/{id}/content": {
      "get": {
        "tags": [
          "通用视频接口"
        ],
        "operationId": "downloadVideo",
        "summary": "下载视频",
        "description": "任务完成后，使用同一 API 密钥读取视频内容。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "提交任务返回的公开任务 ID",
            "schema": {
              "type": "string"
            },
            "example": "video_example"
          }
        ],
        "responses": {
          "200": {
            "description": "视频文件内容",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  }
}
