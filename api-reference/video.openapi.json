{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://tokener.jeekmind.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "info": {
    "title": "通用视频接口",
    "version": "0.1.0",
    "description": "通用视频任务查询与下载接口，响应字段按任务状态区分。"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "技元 API 密钥"
      }
    },
    "schemas": {
      "VideoTask": {
        "title": "视频任务响应",
        "description": "按 status 选择生成中、成功、错误或状态未知的字段结构。",
        "oneOf": [
          {
            "$ref": "#/components/schemas/VideoTaskGenerating"
          },
          {
            "$ref": "#/components/schemas/VideoTaskCompleted"
          },
          {
            "$ref": "#/components/schemas/VideoTaskFailed"
          },
          {
            "$ref": "#/components/schemas/VideoTaskUnknown"
          }
        ]
      },
      "VideoTaskGenerating": {
        "title": "生成中",
        "description": "任务排队或生成中，不返回下载路径。",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "in_progress"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "error": {
            "type": "null",
            "description": "无错误时返回 null。"
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "gxc-doubao-seedance-2-5-260628",
            "status": "in_progress",
            "progress": 50,
            "created_at": 1793851200,
            "error": null
          }
        ]
      },
      "VideoTaskCompleted": {
        "title": "成功",
        "description": "任务成功，可下载视频；有尾帧时返回尾帧下载路径。",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at",
          "completed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "completed_at": {
            "type": "integer",
            "description": "完成时间，Unix 秒级时间戳。"
          },
          "error": {
            "type": "null",
            "description": "无错误时返回 null。"
          },
          "url": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^/v1/videos/[^/]+/content$",
            "description": "成功时返回的下载路径，不含 BaseURL，格式为 /v1/videos/{id}/content，需使用同一 New API Key 认证"
          },
          "url_last_frame": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^/v1/tasks/[^/]+/artifacts/last_frame/content$",
            "description": "GXC、TYY 成功且有尾帧时返回的相对下载路径 /v1/tasks/{id}/artifacts/last_frame/content，需使用同一 API 密钥认证；HC、MYU、ME 不返回此字段。"
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "gxc-doubao-seedance-2-5-260628",
            "status": "completed",
            "progress": 100,
            "created_at": 1793851200,
            "error": null,
            "completed_at": 1793851260,
            "url": "/v1/videos/video_example/content",
            "url_last_frame": "/v1/tasks/video_example/artifacts/last_frame/content"
          }
        ]
      },
      "VideoTaskFailed": {
        "title": "错误",
        "description": "任务失败，有失败原因时返回 error.message，不返回下载路径。",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "failed"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "始终返回；未成功且宿主提供失败原因时为包含 message 的对象，无错误或成功时为 null",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "任务失败原因"
              }
            }
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "gxc-doubao-seedance-2-5-260628",
            "status": "failed",
            "progress": 0,
            "created_at": 1793851200,
            "error": {
              "message": "视频生成失败，请检查输入素材后重试"
            }
          }
        ]
      },
      "VideoTaskUnknown": {
        "title": "状态未知",
        "description": "暂时无法确定任务状态，可继续查询；不返回下载路径。",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "始终返回；未成功且宿主提供失败原因时为包含 message 的对象，无错误或成功时为 null",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "任务失败原因"
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "paths": {
    "/v1/videos/{id}": {
      "get": {
        "tags": [
          "通用视频接口"
        ],
        "operationId": "getVideo",
        "summary": "查询视频任务",
        "description": "使用创建响应中的 id 查询。status 为 completed 后可下载视频。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "提交任务返回的公开任务 ID",
            "schema": {
              "type": "string"
            },
            "example": "video_example"
          }
        ],
        "responses": {
          "200": {
            "description": "视频任务对象；通过 status 区分生成中、成功和任务失败。任务失败仍使用此响应结构。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VideoTask"
                },
                "examples": {
                  "generating": {
                    "summary": "生成中",
                    "value": {
                      "id": "video_example",
                      "object": "video",
                      "model": "gxc-doubao-seedance-2-5-260628",
                      "status": "in_progress",
                      "progress": 50,
                      "created_at": 1793851200,
                      "error": null
                    }
                  },
                  "completed": {
                    "summary": "成功（含尾帧）",
                    "value": {
                      "id": "video_example",
                      "object": "video",
                      "model": "gxc-doubao-seedance-2-5-260628",
                      "status": "completed",
                      "progress": 100,
                      "created_at": 1793851200,
                      "error": null,
                      "completed_at": 1793851260,
                      "url": "/v1/videos/video_example/content",
                      "url_last_frame": "/v1/tasks/video_example/artifacts/last_frame/content"
                    }
                  },
                  "failed": {
                    "summary": "错误（任务失败）",
                    "value": {
                      "id": "video_example",
                      "object": "video",
                      "model": "gxc-doubao-seedance-2-5-260628",
                      "status": "failed",
                      "progress": 0,
                      "created_at": 1793851200,
                      "error": {
                        "message": "视频生成失败，请检查输入素材后重试"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/videos/{id}/content": {
      "get": {
        "tags": [
          "通用视频接口"
        ],
        "operationId": "downloadVideo",
        "summary": "下载视频",
        "description": "任务完成后，使用同一 API 密钥读取视频内容。",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "提交任务返回的公开任务 ID",
            "schema": {
              "type": "string"
            },
            "example": "video_example"
          }
        ],
        "responses": {
          "200": {
            "description": "视频文件内容",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  }
}
