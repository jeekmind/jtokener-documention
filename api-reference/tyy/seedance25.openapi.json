{
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "https://tokener.jeekmind.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "info": {
    "title": "TYY Seedance 2.5",
    "version": "1.0.0",
    "description": "JSON 异步视频生成接口。响应字段按任务状态区分。"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "技元 API 密钥"
      }
    },
    "schemas": {
      "VideoTaskGenerating": {
        "title": "生成中",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "in_progress"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "error": {
            "type": "null",
            "description": "无错误时返回 null"
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "tyy-cdance2.5-0807",
            "status": "in_progress",
            "progress": 0,
            "created_at": 1793851200,
            "error": null
          }
        ]
      },
      "VideoTaskCompleted": {
        "title": "成功",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at",
          "error",
          "completed_at",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "completed"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "completed_at": {
            "type": "integer",
            "description": "完成时间，Unix 秒级时间戳"
          },
          "error": {
            "type": "null",
            "description": "成功时固定为 null"
          },
          "url": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^/v1/videos/[^/]+/content$",
            "description": "成功时返回的网关主视频下载路径 /v1/videos/{id}/content，不含 BaseURL；使用公开任务 ID，需 New API Key 认证"
          },
          "url_last_frame": {
            "type": "string",
            "format": "uri-reference",
            "pattern": "^/v1/tasks/[^/]+/artifacts/last_frame/content$",
            "description": "成功且上游 content.last_frame_url 存在时返回的 last_frame 产物下载路径 /v1/tasks/{id}/artifacts/last_frame/content，不含 BaseURL，需 New API Key 认证"
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "tyy-cdance2.5-0807",
            "status": "completed",
            "progress": 100,
            "created_at": 1793851200,
            "error": null,
            "completed_at": 1793851260,
            "url": "/v1/videos/video_example/content",
            "url_last_frame": "/v1/tasks/video_example/artifacts/last_frame/content"
          }
        ]
      },
      "VideoTaskFailed": {
        "title": "错误",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "failed"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "始终返回；未成功且宿主提供失败原因时为包含 message 的对象，无错误或成功时为 null",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "任务失败原因"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "tyy-cdance2.5-0807",
            "status": "failed",
            "progress": 0,
            "created_at": 1793851200,
            "error": {
              "message": "视频生成失败，请检查输入素材后重试"
            }
          }
        ]
      },
      "VideoTaskUnknown": {
        "title": "状态未知",
        "type": "object",
        "required": [
          "id",
          "object",
          "model",
          "status",
          "progress",
          "created_at",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "网关公开任务 ID，用于后续查询和下载"
          },
          "object": {
            "const": "video",
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "客户端请求的模型名称"
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown"
            ]
          },
          "progress": {
            "type": "integer",
            "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"
          },
          "created_at": {
            "type": "integer",
            "description": "任务创建时间，Unix 秒级时间戳"
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "始终返回；未成功且宿主提供失败原因时为包含 message 的对象，无错误或成功时为 null",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "任务失败原因"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true,
        "examples": [
          {
            "id": "video_example",
            "object": "video",
            "model": "tyy-cdance2.5-0807",
            "status": "unknown",
            "progress": 0,
            "created_at": 1793851200,
            "error": {
              "message": "暂时无法确定任务状态，请稍后查询"
            }
          }
        ]
      },
      "VideoTask": {
        "title": "视频任务响应",
        "oneOf": [
          {
            "$ref": "#/components/schemas/VideoTaskGenerating"
          },
          {
            "$ref": "#/components/schemas/VideoTaskCompleted"
          },
          {
            "$ref": "#/components/schemas/VideoTaskFailed"
          },
          {
            "$ref": "#/components/schemas/VideoTaskUnknown"
          }
        ]
      },
      "VideoGenerationRequest": {
        "title": "VideoGenerationRequest",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "模型调用名",
            "minLength": 1,
            "pattern": "\\S",
            "const": "tyy-cdance2.5-0807"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "非空且不能仅包含空白字符的视频描述"
          },
          "seconds": {
            "type": "integer",
            "description": "输出时长，整数秒；-1 表示智能时长。",
            "anyOf": [
              {
                "const": -1
              },
              {
                "minimum": 4,
                "maximum": 30
              }
            ],
            "default": -1
          },
          "resolution": {
            "type": "string",
            "description": "输出分辨率；适配器转换为上游小写格式。",
            "enum": [
              "480p",
              "720p",
              "1080p"
            ],
            "default": "720p"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "21:9",
              "4:3",
              "3:4",
              "media_adaptive"
            ],
            "description": "画面比例",
            "default": "media_adaptive"
          },
          "provider_tools": {
            "type": "array",
            "description": "提供方工具配置，支持范围由模型限定",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "web_search"
                  ],
                  "description": "工具类型"
                }
              }
            }
          },
          "callback_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://[^\\s/?#]+(?:[/?#]\\S*)?$",
            "description": "提供方直接发送任务通知的 HTTP(S) 回调地址"
          },
          "input_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "url"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "image",
                    "video",
                    "audio"
                  ],
                  "description": "媒体类型"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://",
                  "description": "生成期间持续可访问的 HTTP(S) URL"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "reference",
                    "first_frame",
                    "last_frame"
                  ],
                  "default": "reference",
                  "description": "素材用途，首帧和尾帧仅适用于图片"
                }
              },
              "if": {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "video",
                      "audio"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "role": {
                    "const": "reference"
                  }
                }
              }
            },
            "description": "普通参考最多 30 张图片、10 个视频、10 个音频；或首帧一张、可选尾帧一张。参考视频和音频各自合计最多 30 秒。单个参考视频和音频至少 2 秒；媒体时长需运行时校验。",
            "maxItems": 50,
            "allOf": [
              {
                "if": {
                  "contains": {
                    "type": "object",
                    "required": [
                      "role"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "first_frame",
                          "last_frame"
                        ]
                      }
                    }
                  }
                },
                "then": {
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": [
                      "type",
                      "role"
                    ],
                    "properties": {
                      "type": {
                        "const": "image"
                      },
                      "role": {
                        "enum": [
                          "first_frame",
                          "last_frame"
                        ]
                      }
                    }
                  },
                  "allOf": [
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "role"
                        ],
                        "properties": {
                          "role": {
                            "const": "first_frame"
                          }
                        }
                      },
                      "minContains": 1,
                      "maxContains": 1
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "role"
                        ],
                        "properties": {
                          "role": {
                            "const": "last_frame"
                          }
                        }
                      },
                      "minContains": 0,
                      "maxContains": 1
                    }
                  ]
                },
                "else": {
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "const": "reference"
                      }
                    }
                  },
                  "allOf": [
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "image"
                          }
                        }
                      },
                      "minContains": 0,
                      "maxContains": 30
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "video"
                          }
                        }
                      },
                      "minContains": 0,
                      "maxContains": 10
                    },
                    {
                      "contains": {
                        "type": "object",
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "audio"
                          }
                        }
                      },
                      "minContains": 0,
                      "maxContains": 10
                    }
                  ]
                }
              }
            ]
          },
          "options": {
            "type": "object",
            "additionalProperties": false,
            "description": "视频生成选项",
            "properties": {
              "task_type": {
                "type": "string",
                "enum": [
                  "auto",
                  "reference",
                  "edit",
                  "extend"
                ],
                "description": "映射 omni_reference_task_type；edit/extend 必须提供参考视频并使用自适应比例，edit 时长须省略或为 -1。"
              },
              "video_output_format": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "description": "输出视频容器格式，支持范围由模型限定",
                "enum": [
                  "mp4",
                  "mov"
                ]
              },
              "return_last_frame": {
                "type": "boolean",
                "description": "是否返回最后一帧",
                "default": false
              },
              "watermark": {
                "type": "boolean",
                "description": "是否添加水印",
                "default": false
              },
              "generate_audio": {
                "type": "boolean",
                "description": "是否生成音频",
                "default": true
              }
            },
            "default": {}
          }
        },
        "description": "TYY Seedance25 用户输入；HTTP(S) 素材，首尾帧与普通参考互斥。素材可访问性、大小、编码、尺寸与实际时长需运行时校验。",
        "anyOf": [
          {
            "required": [
              "prompt"
            ]
          },
          {
            "required": [
              "input_references"
            ],
            "properties": {
              "input_references": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        ],
        "allOf": [
          {
            "if": {
              "required": [
                "input_references"
              ],
              "properties": {
                "input_references": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "required": [
                      "role"
                    ],
                    "properties": {
                      "role": {
                        "enum": [
                          "first_frame",
                          "last_frame"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "aspect_ratio": {
                  "const": "media_adaptive"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "type": "object",
                  "required": [
                    "task_type"
                  ],
                  "properties": {
                    "task_type": {
                      "enum": [
                        "reference",
                        "edit",
                        "extend"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "input_references"
              ],
              "properties": {
                "input_references": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "const": "reference"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "type": "object",
                  "required": [
                    "task_type"
                  ],
                  "properties": {
                    "task_type": {
                      "enum": [
                        "edit",
                        "extend"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "required": [
                "input_references"
              ],
              "properties": {
                "input_references": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "video"
                      }
                    }
                  }
                },
                "aspect_ratio": {
                  "const": "media_adaptive"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "options"
              ],
              "properties": {
                "options": {
                  "type": "object",
                  "required": [
                    "task_type"
                  ],
                  "properties": {
                    "task_type": {
                      "enum": [
                        "edit"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "seconds": {
                  "const": -1
                }
              }
            }
          }
        ]
      },
      "VideoRequestError": {
        "title": "输入错误",
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "错误标识，例如 plugin_request_invalid"
          },
          "message": {
            "type": "string",
            "description": "具体输入校验错误，可能包含插件版本与参数路径"
          },
          "data": {
            "type": "null",
            "description": "无任务数据"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/videos": {
      "post": {
        "tags": [
          "TYY 视频"
        ],
        "operationId": "createTyySeedance25",
        "summary": "TYY Seedance 2.5 视频生成",
        "description": "使用 JSON 提交异步视频任务。保存响应 id，使用同一 API 密钥查询任务和下载产物。 任务完成后，推荐使用查询结果中的 url 下载视频；相对路径需拼接 API 服务地址，并携带同一 API 密钥。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoGenerationRequest"
              },
              "examples": {
                "text": {
                  "summary": "文生视频",
                  "value": {
                    "model": "tyy-cdance2.5-0807",
                    "prompt": "清晨湖面，一只纸船缓缓漂行",
                    "seconds": 5,
                    "resolution": "720p",
                    "aspect_ratio": "16:9"
                  }
                },
                "reference": {
                  "summary": "参考图片生视频",
                  "value": {
                    "model": "tyy-cdance2.5-0807",
                    "prompt": "清晨湖面，一只纸船缓缓漂行",
                    "seconds": 5,
                    "resolution": "720p",
                    "aspect_ratio": "16:9",
                    "input_references": [
                      {
                        "type": "image",
                        "url": "https://example.com/reference.jpg",
                        "role": "reference"
                      }
                    ]
                  }
                },
                "frames": {
                  "summary": "首尾帧生视频",
                  "value": {
                    "model": "tyy-cdance2.5-0807",
                    "prompt": "清晨湖面，一只纸船缓缓漂行",
                    "seconds": 5,
                    "resolution": "720p",
                    "aspect_ratio": "media_adaptive",
                    "input_references": [
                      {
                        "type": "image",
                        "url": "https://example.com/first.jpg",
                        "role": "first_frame"
                      },
                      {
                        "type": "image",
                        "url": "https://example.com/last.jpg",
                        "role": "last_frame"
                      }
                    ]
                  }
                },
                "edit": {
                  "summary": "编辑参考视频",
                  "value": {
                    "model": "tyy-cdance2.5-0807",
                    "prompt": "清晨湖面，一只纸船缓缓漂行",
                    "seconds": -1,
                    "resolution": "720p",
                    "aspect_ratio": "media_adaptive",
                    "input_references": [
                      {
                        "type": "video",
                        "url": "https://example.com/reference.mp4"
                      }
                    ],
                    "options": {
                      "task_type": "edit",
                      "video_output_format": "mp4"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "视频任务对象；通过 status 区分生成中、成功和任务失败。任务失败仍使用此响应结构。",
            "content": {
              "application/json": {
                "schema": {
