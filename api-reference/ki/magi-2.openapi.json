{
    "openapi"   : "3.1.0",
    "servers"   : [ {"url": "https://tokener.jeekmind.com"} ],
    "security"  : [ {"bearerAuth": []} ],
    "info"      : {"title": "Ki Magi-2", "version": "1.0.0", "description": "Magi-2 JSON 异步视频生成接口，支持文生视频、首尾帧和参考媒体。"},
    "components": {
        "securitySchemes": { "bearerAuth": {"type": "http", "scheme": "bearer", "description": "技元 API 密钥"} },
        "schemas"        : {
            "VideoTaskGenerating"   : {
                "title": "生成中",
                "type": "object",
                "required": ["id", "object", "model", "status", "progress", "created_at", "error"],
                "properties": {
                    "id"        : {"type": "string", "description": "网关公开任务 ID，用于后续查询和下载"},
                    "object"    : {"const": "video", "type": "string"},
                    "model"     : {"type": "string", "description": "客户端请求的模型名称"},
                    "status"    : { "type": "string", "enum": ["queued", "in_progress"] },
                    "progress"  : {"type": "integer", "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"},
                    "created_at": {"type": "integer", "description": "任务创建时间，Unix 秒级时间戳"},
                    "error"     : {"type": "null", "description": "无错误时返回 null"}
                },
                "additionalProperties": true,
                "examples": [
                    {
                        "id"        : "video_example",
                        "object"    : "video",
                        "model"     : "ki-magi-2",
                        "status"    : "in_progress",
                        "progress"  : 0,
                        "created_at": 1793851200,
                        "error"     : null
                    }
                ],
                "not": {
                    "anyOf": [
                        { "required": ["url_path"] },
                        { "required": ["url"     ] }
                    ]
                }
            },
            "VideoTaskCompleted"    : {
                "title"               : "成功",
                "type"                : "object",
                "required"            : [
                    "id",           "object",       "model",        "status",       "progress",     "created_at",
                    "error",        "completed_at", "url_path",     "url"
                ],
                "properties"          : {
                    "id"          : {"type": "string", "description": "网关公开任务 ID，用于后续查询和下载"},
                    "object"      : {"const": "video", "type": "string"},
                    "model"       : {"type": "string", "description": "客户端请求的模型名称"},
                    "status"      : { "type": "string", "enum": ["completed"] },
                    "progress"    : {"type": "integer", "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"},
                    "created_at"  : {"type": "integer", "description": "任务创建时间，Unix 秒级时间戳"},
                    "completed_at": {"type": "integer", "description": "完成时间，Unix 秒级时间戳"},
                    "error"       : {"type": "null", "description": "成功时固定为 null"},
                    "url"         : {
                        "type"       : "string",
                        "format"     : "uri-reference",
                        "pattern"    : "^/v1/videos/[^/]+/content$",
                        "deprecated" : true,
                        "description": "已弃用的兼容字段，值与 url_path 相同；新客户端请使用 url_path。"
                    },
                    "url_path"    : {
                        "type"       : "string",
                        "format"     : "uri-reference",
                        "pattern"    : "^/v1/videos/[^/]+/content$",
                        "description": "成功时返回的网关主视频下载路径 /v1/videos/{id}/content，不含 BaseURL；使用公开任务 ID，需 New API Key 认证"
                    }
                },
                "additionalProperties": true,
                "examples"            : [
                    {
                        "id"          : "video_example",
                        "object"      : "video",
                        "model"       : "ki-magi-2",
                        "status"      : "completed",
                        "progress"    : 100,
                        "created_at"  : 1793851200,
                        "error"       : null,
                        "completed_at": 1793851260,
                        "url_path"    : "/v1/videos/video_example/content",
                        "url"         : "/v1/videos/video_example/content"
                    }
                ]
            },
            "VideoTaskFailed"       : {
                "title": "错误",
                "type": "object",
                "required": ["id", "object", "model", "status", "progress", "created_at", "error"],
                "properties": {
                    "id"        : {"type": "string", "description": "网关公开任务 ID，用于后续查询和下载"},
                    "object"    : {"const": "video", "type": "string"},
                    "model"     : {"type": "string", "description": "客户端请求的模型名称"},
                    "status"    : { "type": "string", "enum": ["failed"] },
                    "progress"  : {"type": "integer", "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"},
                    "created_at": {"type": "integer", "description": "任务创建时间，Unix 秒级时间戳"},
                    "error"     : {
                        "type"                : ["object", "null"],
                        "description"         : "始终返回；未成功且宿主提供失败原因时为包含 message 的对象，无错误或成功时为 null",
                        "required"            : ["message"],
                        "properties"          : { "message": {"type": "string", "description": "任务失败原因"} },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": true,
                "examples": [
                    {
                        "id"        : "video_example",
                        "object"    : "video",
                        "model"     : "ki-magi-2",
                        "status"    : "failed",
                        "progress"  : 0,
                        "created_at": 1793851200,
                        "error"     : {"message": "视频生成失败，请检查输入素材后重试"}
                    }
                ],
                "not": {
                    "anyOf": [
                        { "required": ["url_path"] },
                        { "required": ["url"     ] }
                    ]
                }
            },
            "VideoTaskUnknown"      : {
                "title": "状态未知",
                "type": "object",
                "required": ["id", "object", "model", "status", "progress", "created_at", "error"],
                "properties": {
                    "id"        : {"type": "string", "description": "网关公开任务 ID，用于后续查询和下载"},
                    "object"    : {"const": "video", "type": "string"},
                    "model"     : {"type": "string", "description": "客户端请求的模型名称"},
                    "status"    : { "type": "string", "enum": ["unknown"] },
                    "progress"  : {"type": "integer", "description": "宿主将内部进度字符串转换为整数，解析失败时为 0"},
                    "created_at": {"type": "integer", "description": "任务创建时间，Unix 秒级时间戳"},
                    "error"     : {
                        "type"                : ["object", "null"],
                        "description"         : "始终返回；未成功且宿主提供失败原因时为包含 message 的对象，无错误或成功时为 null",
                        "required"            : ["message"],
                        "properties"          : { "message": {"type": "string", "description": "任务失败原因"} },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": true,
                "examples": [
                    {
                        "id"        : "video_example",
                        "object"    : "video",
                        "model"     : "ki-magi-2",
                        "status"    : "unknown",
                        "progress"  : 0,
                        "created_at": 1793851200,
                        "error"     : {"message": "暂时无法确定任务状态，请稍后查询"}
                    }
                ],
                "not": {
                    "anyOf": [
                        { "required": ["url_path"] },
                        { "required": ["url"     ] }
                    ]
                }
            },
            "VideoTask"             : {
                "title": "视频任务响应",
                "oneOf": [
                    {"$ref": "#/components/schemas/VideoTaskGenerating"},
                    {"$ref": "#/components/schemas/VideoTaskCompleted" },
                    {"$ref": "#/components/schemas/VideoTaskFailed"    },
                    {"$ref": "#/components/schemas/VideoTaskUnknown"   }
                ]
            },
            "VideoGenerationRequest": {
                "title": "KiMagi2Request",
                "description": "使用 ki-magi-2 提交视频生成任务。素材 role 默认 reference；首尾帧模式须显式指定 first_frame。",
                "type": "object",
                "additionalProperties": false,
                "required": ["model", "prompt"],
                "properties": {
                    "model"           : {"type": "string", "const": "ki-magi-2"},
                    "prompt"          : {"type": "string", "minLength": 1, "maxLength": 15000, "pattern": "\\S"},
                    "seconds"         : {"type": "integer", "minimum": 4, "maximum": 30, "default": 5},
                    "resolution"      : { "type": "string", "enum": ["1080p"], "default": "1080p" },
                    "options"         : {
                        "type"                : "object",
                        "additionalProperties": false,
                        "default"             : {},
                        "properties"          : {
                            "generate_audio"       : {"type": "boolean", "default": true},
                            "video_generation_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
                        }
                    },
                    "aspect_ratio"    : {
                        "type"       : "string",
                        "enum"       : ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16", "media_adaptive"],
                        "description": "首尾帧模式省略或 media_adaptive；其他模式默认 16:9。"
                    },
                    "input_references": {
                        "type"       : "array",
                        "items"      : {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["type", "url"],
                            "properties": {
                                "type": { "type": "string", "enum": ["image", "video", "audio"] },
                                "url" : {"type": "string", "format": "uri", "pattern": "^https?://"},
                                "role": {
                                    "type"   : "string",
                                    "enum"   : ["reference", "first_frame", "last_frame"],
                                    "default": "reference"
                                }
                            },
                            "if": {
                                "properties": {
                                    "type": { "enum": ["video", "audio"] }
                                },
                                "required"  : ["type"]
                            },
                            "then": {
                                "properties": { "role": {"const": "reference"} }
                            }
                        },
                        "maxItems"   : 20,
                        "description": "无素材为文生；显式首尾帧角色为图生；其余素材为参考模式，角色默认 reference。"
                    }
                },
                "if": {
                    "required"  : ["input_references"],
                    "properties": {
                        "input_references": {
                            "type"    : "array",
                            "contains": {
                                "type"      : "object",
                                "required"  : ["role"],
                                "properties": {
                                    "role": { "enum": ["first_frame", "last_frame"] }
                                }
                            }
                        }
                    }
                },
                "then": {
                    "properties": {
                        "aspect_ratio"    : {
                            "type"       : "string",
                            "const"      : "media_adaptive",
                            "description": "由首帧比例决定，不向上游传递"
                        },
                        "input_references": {
                            "type"    : "array",
                            "maxItems": 2,
                            "minItems": 1,
                            "allOf"   : [
                                {
                                    "contains"   : {
                                        "type"      : "object",
                                        "required"  : ["role"],
                                        "properties": { "role": {"const": "first_frame"} }
                                    },
                                    "minContains": 1,
                                    "maxContains": 1
                                },
                                {
                                    "contains"   : {
                                        "type"      : "object",
                                        "required"  : ["role"],
                                        "properties": { "role": {"const": "last_frame"} }
                                    },
                                    "minContains": 0,
                                    "maxContains": 1
                                }
                            ],
                            "items"   : {
                                "type"      : "object",
                                "properties": {
                                    "type": { "const": "image"                                        },
                                    "role": {                   "enum": ["first_frame", "last_frame"] }
                                },
                                "required"  : ["type", "role"]
                            }
                        }
                    }
                },
                "else": {
                    "properties": {
                        "aspect_ratio"    : {
                            "type"   : "string",
                            "enum"   : ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"],
                            "default": "16:9"
                        },
                        "input_references": {
                            "type" : "array",
                            "items": {
                                "type"      : "object",
                                "properties": { "role": {"const": "reference"} }
                            },
                            "allOf": [
                                {
                                    "contains"   : {
                                        "type"      : "object",
                                        "required"  : ["type"],
                                        "properties": { "type": {"const": "image"} }
                                    },
                                    "minContains": 0,
                                    "maxContains": 10
                                },
                                {
                                    "contains"   : {
                                        "type"      : "object",
                                        "required"  : ["type"],
                                        "properties": { "type": {"const": "video"} }
                                    },
                                    "minContains": 0,
                                    "maxContains": 5
                                },
                                {
                                    "contains"   : {
                                        "type"      : "object",
                                        "required"  : ["type"],
                                        "properties": { "type": {"const": "audio"} }
                                    },
                                    "minContains": 0,
                                    "maxContains": 5
                                }
                            ]
                        }
                    }
                }
            },
            "VideoRequestError"     : {
                "title"     : "输入错误",
                "type"      : "object",
                "required"  : ["code", "message", "data"],
                "properties": {
                    "code"   : {"type": "string", "description": "错误标识，例如 plugin_request_invalid"},
                    "message": {"type": "string", "description": "具体输入校验错误，可能包含插件版本与参数路径"        },
                    "data"   : {"type": "null",   "description": "无任务数据"                         }
                }
            }
        }
    },
    "paths"     : {
        "/v1/videos": {
            "post": {
                "tags"       : ["Ki Magi-2"],
                "operationId": "createKiMagi2Video",
                "summary"    : "Ki Magi-2 视频生成",
                "description": "使用 JSON 提交视频任务。保存响应 id 并使用同一 API 密钥查询。成功后使用 url_path 下载主视频；先拼接 API 服务地址，再携带同一 API 密钥。",
                "requestBody": {
                    "required": true,
                    "content" : {
                        "application/json": {
                            "schema"  : {"$ref": "#/components/schemas/VideoGenerationRequest"},
                            "examples": {
                                "text"     : {
                                    "summary": "文生视频",
                                    "value"  : {"model": "ki-magi-2", "prompt": "飞机穿过云霄", "seconds": 4}
                                },
                                "frames"   : {
                                    "summary": "首尾帧",
                                    "value"  : {
                                        "model"           : "ki-magi-2",
                                        "prompt"          : "镜头缓慢推进，水面泛起涟漪",
                                        "seconds"         : 5,
                                        "input_references": [
                                            {
                                                "type": "image",
                                                "role": "first_frame",
                                                "url" : "https://example.com/first.png"
                                            },
                                            {
                                                "type": "image",
                                                "role": "last_frame",
                                                "url" : "https://example.com/last.png"
                                            }
                                        ]
                                    }
                                },
                                "reference": {
                                    "summary": "参考图片与视频",
                                    "value"  : {
                                        "model"           : "ki-magi-2",
                                        "prompt"          : "保持参考人物形象，并参考视频中的运镜",
                                        "input_references": [
                                            {"type": "image", "url": "https://example.com/person.png"},
                                            {"type": "video", "url": "https://example.com/motion.mp4"}
                                        ],
                                        "options"         : {"generate_audio": false, "video_generation_seed": 0}
                                    }
                                }
                            }
                        }
                    }
                },
                "responses"  : {
                    "200": {
                        "description": "视频任务对象；通过 status 区分生成中、成功和任务失败。任务失败仍使用此响应结构。",
                        "content"    : {
                            "application/json": {
                                "schema"  : {"$ref": "#/components/schemas/VideoTask"},
                                "examples": {
                                    "generating": {
                                        "summary": "生成中",
                                        "value"  : {
                                            "id"        : "video_example",
                                            "object"    : "video",
                                            "model"     : "ki-magi-2",
                                            "status"    : "in_progress",
                                            "progress"  : 0,
                                            "created_at": 1793851200,
                                            "error"     : null
                                        }
                                    },
                                    "completed" : {
                                        "summary": "成功",
                                        "value"  : {
                                            "id"          : "video_example",
                                            "object"      : "video",
                                            "model"       : "ki-magi-2",
                                            "status"      : "completed",
                                            "progress"    : 100,
                                            "created_at"  : 1793851200,
                                            "error"       : null,
                                            "completed_at": 1793851260,
                                            "url_path"    : "/v1/videos/video_example/content",
                                            "url"         : "/v1/videos/video_example/content"
                                        }
                                    },
                                    "failed"    : {
                                        "summary": "错误",
                                        "value"  : {
                                            "id"        : "video_example",
                                            "object"    : "video",
                                            "model"     : "ki-magi-2",
                                            "status"    : "failed",
                                            "progress"  : 0,
                                            "created_at": 1793851200,
                                            "error"     : {"message": "视频生成失败，请检查输入素材后重试"}
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "输入错误",
                        "content"    : {
                            "application/json": {
                                "schema"  : {"$ref": "#/components/schemas/VideoRequestError"},
                                "examples": {
                                    "invalid_input": {
                                        "summary"    : "输入错误",
                                        "value"      : {
                                            "code"   : "plugin_request_invalid",
                                            "message": "输入错误，请检查参数取值和素材组合",
                                            "data"   : null
                                        },
                                        "description": "输入校验错误示例。具体错误消息以当前模型返回为准。"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
