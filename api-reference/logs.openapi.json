{
  "openapi": "3.1.0",
  "info": {
    "title": "个人日志 API",
    "version": "0.1.0",
    "description": "查询当前用户日志。使用 nap_ 系统访问令牌时无需 New-Api-User 请求头，接口根据令牌识别用户。不能使用模型调用 API 密钥。"
  },
  "servers": [
    {
      "url": "https://tokener.jeekmind.com"
    }
  ],
  "security": [
    {
      "systemAccessToken": []
    }
  ],
  "paths": {
    "/api/log/self": {
      "get": {
        "operationId": "getSelfLogs",
        "summary": "获取个人日志",
        "description": "分页查询当前用户日志。可查询的时间范围受站点配置及日志保留策略限制。",
        "parameters": [
          {
            "name": "p",
            "in": "query",
            "description": "页码，从 1 开始。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "每页条数。未指定时使用站点默认值。",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "example": 20
          },
          {
            "name": "type",
            "in": "query",
            "description": "日志类型；0 表示不按类型筛选。",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "start_timestamp",
            "in": "query",
            "description": "起始时间，Unix 秒级时间戳。",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "end_timestamp",
            "in": "query",
            "description": "结束时间，Unix 秒级时间戳。",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "model_name",
            "in": "query",
            "description": "模型名称。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "token_name",
            "in": "query",
            "description": "API 令牌名称。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "group",
            "in": "query",
            "description": "调用分组。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "request_id",
            "in": "query",
            "description": "请求标识。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "请求处理结果。检查 success；成功时 data 包含分页日志。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogResponse"
                },
                "example": {
                  "success": true,
                  "message": "",
                  "data": {
                    "page": 1,
                    "page_size": 1,
                    "total": 143,
                    "items": [
                      {
                        "id": 1,
                        "user_id": 3,
                        "created_at": 1795695591,
                        "type": 2,
                        "content": "Action , Billing parameters: output_video_duration: 4",
                        "username": "example-user",
                        "token_name": "example-token",
                        "model_name": "ki-magi-2",
                        "quota": 285714,
                        "prompt_tokens": 0,
                        "completion_tokens": 0,
                        "use_time": 0,
                        "is_stream": false,
                        "channel": 21,
                        "channel_name": "",
                        "token_id": 14,
                        "group": "example-group",
                        "ip": "",
                        "request_id": "example-request-id",
                        "other": "{\"billing_mode\":\"tiered_expr\",\"group_ratio\":1,\"is_task\":true,\"matched_tier\":\"base\",\"model_price\":0,\"request_path\":\"/v1/videos\",\"task_id\":\"task_example\",\"usage_facts\":{\"output_video_duration\":4}}"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "未通过认证。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "AUTH_UNAUTHORIZED",
                  "message": "Unauthorized, invalid access token",
                  "message_key": "Unauthorized, invalid access token",
                  "success": false
                }
              }
            }
          },
          "default": {
            "description": "权限、参数、时间范围、限流或服务异常。读取实际状态码和错误消息。"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "systemAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "系统访问令牌，示例 YOUR_ACCESS_TOKEN。不能使用模型调用的 sk- API 密钥。"
      }
    },
    "schemas": {
      "Log": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "日志列表展示序号，不保证跨请求稳定。"
          },
          "user_id": {
            "type": "integer",
            "description": "日志所属用户 ID。"
          },
          "created_at": {
            "type": "integer",
            "description": "日志时间，Unix 秒级时间戳。"
          },
          "type": {
            "type": "integer",
            "description": "日志类型：0 未知、1 充值、2 消费、3 管理、4 系统、5 错误、6 退款、7 登录。可用类型取决于站点版本。"
          },
          "content": {
            "type": "string",
            "description": "日志说明或错误信息。"
          },
          "username": {
            "type": "string",
            "description": "用户名。"
          },
          "token_name": {
            "type": "string",
            "description": "模型调用所用的 API 令牌名称。"
          },
          "model_name": {
            "type": "string",
            "description": "模型名称。"
          },
          "quota": {
            "type": "integer",
            "description": "本条日志记录的额度值。系统美元金额 = quota / quota_per_unit；人民币显示金额 = quota / quota_per_unit × usd_exchange_rate。换算配置通过 GET /api/status 获取。当前站点为 CNY、quota_per_unit=500000、usd_exchange_rate=7，因此示例 285714 对应 3.999996 元，保留两位小数显示为 ¥4.00。配置可能调整，不要重复乘以分组倍率或模型价格。"
          },
          "prompt_tokens": {
            "type": "integer",
            "description": "输入 token 数。"
          },
          "completion_tokens": {
            "type": "integer",
            "description": "输出 token 数。"
          },
          "use_time": {
            "type": "integer",
            "description": "耗时，单位秒。"
          },
          "is_stream": {
            "type": "boolean",
            "description": "是否为流式调用。"
          },
          "channel": {
            "type": "integer",
            "description": "渠道 ID。"
          },
          "channel_name": {
            "type": "string",
            "description": "渠道名称，个人日志中可能为空。"
          },
          "token_id": {
            "type": "integer",
            "description": "模型调用所用的 API 令牌 ID。"
          },
          "group": {
            "type": "string",
            "description": "调用所属分组。"
          },
          "ip": {
            "type": "string",
            "description": "调用方 IP，未记录时为空字符串。"
          },
          "request_id": {
            "type": "string",
            "description": "请求标识，可能省略。"
          },
          "upstream_request_id": {
            "type": "string",
            "description": "上游请求标识，依站点版本和日志记录情况返回，可能省略。"
          },
          "other": {
            "type": "string",
            "description": "JSON 字符串。解析后可能包含任务 ID、计费信息或错误详情，属性随日志类型变化。"
          }
        }
      },
      "LogResponse": {
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "业务是否成功。"
          },
          "message": {
            "type": "string",
            "description": "结果消息。"
          },
          "data": {
            "type": "object",
            "required": [
              "page",
              "page_size",
              "total",
              "items"
            ],
            "properties": {
              "page": {
                "type": "integer",
                "description": "当前页码。"
              },
              "page_size": {
                "type": "integer",
                "description": "每页条数。"
              },
              "total": {
                "type": "integer",
                "description": "匹配条件的总条数。"
              },
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Log"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "message_key": {
            "type": "string"
          }
        }
      }
    }
  }
}
